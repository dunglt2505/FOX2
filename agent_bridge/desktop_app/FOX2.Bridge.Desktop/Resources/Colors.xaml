<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#0B1017</Color>
    <Color x:Key="HeaderColor">#0B131E</Color>
    <Color x:Key="SidebarColor">#0D1723</Color>
    <Color x:Key="SurfaceColor">#111923</Color>
    <Color x:Key="SurfaceElevatedColor">#17212D</Color>
    <Color x:Key="BorderColor">#263241</Color>
    <Color x:Key="AccentColor">#F59E0B</Color>
    <Color x:Key="InfoColor">#38BDF8</Color>
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="CriticalColor">#EF4444</Color>
    <Color x:Key="TextPrimaryColor">#F4F7FA</Color>
    <Color x:Key="TextSecondaryColor">#9CA9B7</Color>
    <Color x:Key="TextMutedColor">#647383</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource HeaderColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#322113"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#8C5B16"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
</ResourceDictionary>
