<UserControl x:Class="FOX2.Bridge.Desktop.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Activity" Style="{StaticResource TitleTextStyle}" FontSize="26"/>
            <TextBlock Text="Readable local UI timeline. This view does not alter Bridge history or the execution ledger."
                       Style="{StaticResource MutedTextStyle}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <ListView ItemsSource="{Binding Items}"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{StaticResource TextPrimaryBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Style="{StaticResource MutedTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Type}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"/>
                            <Border Grid.Column="3"
                                    Background="{StaticResource SurfaceElevatedBrush}"
                                    CornerRadius="10"
                                    Padding="8,3"
                                    HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Status}" FontSize="11"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
