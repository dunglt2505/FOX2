<UserControl x:Class="FOX2.Bridge.Desktop.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Diagnostics" Style="{StaticResource TitleTextStyle}" FontSize="26"/>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,18,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Runtime" Style="{StaticResource SectionTitleTextStyle}"/>
                    <TextBlock Text="{Binding BridgeRoot}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Open logs"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenLogsCommand}"
                            Margin="0,0,10,0"/>
                    <Button Content="Save support bundle"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveSupportBundleCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <ListView ItemsSource="{Binding Tools}"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{StaticResource TextPrimaryBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Available}" Style="{StaticResource MutedTextStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding AuthStatus}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Version}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
