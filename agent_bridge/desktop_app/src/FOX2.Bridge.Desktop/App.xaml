<Application x:Class="FOX2.Bridge.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="Surface" Color="#111923"/><SolidColorBrush x:Key="Elevated" Color="#17212D"/>
  <SolidColorBrush x:Key="Border" Color="#263241"/><SolidColorBrush x:Key="Orange" Color="#F59E0B"/>
  <SolidColorBrush x:Key="Info" Color="#38BDF8"/><SolidColorBrush x:Key="Success" Color="#22C55E"/>
  <SolidColorBrush x:Key="Critical" Color="#EF4444"/><SolidColorBrush x:Key="Secondary" Color="#9CA9B7"/><SolidColorBrush x:Key="Muted" Color="#647383"/>
  <Style x:Key="ShellWindow" TargetType="Window"><Setter Property="Background" Value="#0B1017"/><Setter Property="Foreground" Value="#F4F7FA"/><Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/><Setter Property="FontSize" Value="15"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{StaticResource Elevated}"/><Setter Property="Foreground" Value="#F4F7FA"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,10,10"/>
   <Setter Property="FocusVisualStyle"><Setter.Value><Style><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border BorderBrush="#38BDF8" BorderThickness="2" Margin="-3"/></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#F4F7FA"/><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Padding" Value="18,14"/><Setter Property="MinWidth" Value="180"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Nav" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}"><TextBlock x:Name="NavLabel" Text="{TemplateBinding Header}" Foreground="{StaticResource Secondary}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Nav" Property="Background" Value="#17212D"/><Setter TargetName="NavLabel" Property="Foreground" Value="#F59E0B"/><Setter TargetName="Nav" Property="BorderBrush" Value="#F59E0B"/><Setter TargetName="Nav" Property="BorderThickness" Value="4,0,0,1"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Nav" Property="BorderBrush" Value="#38BDF8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,16,16"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Application.Resources>
</Application>
