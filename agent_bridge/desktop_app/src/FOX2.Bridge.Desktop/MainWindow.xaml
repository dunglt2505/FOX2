<Window x:Class="FOX2.Bridge.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource ShellWindow}" Title="FOX2 Bridge RC1" Width="1180" Height="760" MinWidth="1040" MinHeight="680" AutomationProperties.Name="FOX2 Bridge RC1">
 <DockPanel Margin="24">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="FOX2  /  BRIDGE" Foreground="{StaticResource Orange}" FontWeight="SemiBold" FontSize="24"/><TextBlock Text="RC1 Ã‚Â· Local execution console" Foreground="{StaticResource Secondary}" Margin="0,6,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Pause / Resume" Command="{Binding PauseResume}" AutomationProperties.Name="Pause or resume polling" AutomationProperties.AutomationId="PauseResume"/><Button Content="Check now" Command="{Binding CheckNow}" ToolTip="Disabled while polling is paused" AutomationProperties.Name="Check now" AutomationProperties.AutomationId="CheckNow"/></StackPanel>
  </Grid>
  <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,14,0,0"><StackPanel><TextBlock Text="{Binding Message}" Foreground="{StaticResource Info}"/><TextBlock Text="Closing this window hides to Tray. Worker continues running." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
  <TabControl x:Name="Navigation" TabStripPlacement="Left" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="#0B1017" BorderThickness="0" Foreground="#F4F7FA" AutomationProperties.Name="Navigation">
   <TabItem Header="Dashboard" AutomationProperties.Name="Dashboard"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,0,0,0">
    <TextBlock Text="Dashboard" FontSize="28" Margin="0,0,0,20"/>
    <UniformGrid Columns="2">
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="BRIDGE STATUS" Foreground="{StaticResource Secondary}"/><TextBlock Text="{Binding StatusLabel}" FontSize="30" Foreground="{StaticResource Orange}" Margin="0,12,0,6" AutomationProperties.AutomationId="BridgeState"/><TextBlock Text="{Binding Polling}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CURRENT TASK" Foreground="{StaticResource Secondary}"/><TextBlock Text="{Binding CurrentTask}" FontSize="20" Margin="0,12,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="WORKER" Foreground="{StaticResource Secondary}"/><TextBlock Text="{Binding WorkerHealth}" Margin="0,12,0,8"/><TextBlock Text="{Binding Heartbeat}" Foreground="{StaticResource Secondary}" FontSize="12"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LAST RESULT" Foreground="{StaticResource Secondary}"/><TextBlock Text="{Binding LastResult}" Margin="0,12,0,0" FontSize="20"/></StackPanel></Border>
    </UniformGrid>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AGENT OBSERVATIONS" Foreground="{StaticResource Secondary}"/><TextBlock Text="{Binding AgentSummary}" Margin="0,12,0,8"/><TextBlock Text="{Binding Agents}"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Activity" AutomationProperties.Name="Activity"><StackPanel Margin="24,0,0,0"><TextBlock Text="Activity" FontSize="28"/><TextBlock Text="Session activity Ã‚Â· transitions observed while Desktop is open" Foreground="{StaticResource Secondary}" Margin="0,12,0,20"/><ItemsControl ItemsSource="{Binding Activity}"/></StackPanel></TabItem>
   <TabItem Header="Agents" AutomationProperties.Name="Agents"><StackPanel Margin="24,0,0,0"><TextBlock Text="Agents" FontSize="28"/><TextBlock Text="{Binding Agents}" Margin="0,24,0,16"/><TextBlock Text="Routing is selected by executable Dispatch. Usage / capacity not provided by CLI is not interpreted as exhausted." Foreground="{StaticResource Secondary}"/></StackPanel></TabItem>
   <TabItem Header="Diagnostics" AutomationProperties.Name="Diagnostics"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,0,0,0"><TextBlock Text="Diagnostics" FontSize="28"/><WrapPanel Margin="0,20,0,10"><Button Content="Open Logs" Command="{Binding OpenLogs}" AutomationProperties.Name="Open Logs"/><Button Content="Save Support Bundle" Click="SaveSupport" AutomationProperties.Name="Save Support Bundle"/><Button Content="Copy Summary" Click="CopySummary" AutomationProperties.Name="Copy diagnostic summary"/></WrapPanel><TextBox Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="{StaticResource Surface}" Foreground="#F4F7FA" BorderBrush="{StaticResource Border}" Padding="18" AutomationProperties.Name="Diagnostic summary"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Artifacts" AutomationProperties.Name="Artifacts"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,0,0,0">
    <TextBlock Text="Artifact Vault" FontSize="28"/>
    <TextBlock Text="LOCAL_SAVED only | Local saved != Git synced != Released" Foreground="{StaticResource Orange}" Margin="0,12,0,20"/>
    <WrapPanel><Button Content="Save local file..." Click="SaveArtifact" AutomationProperties.Name="Save local artifact"/><Button Content="Browse Vault" Click="BrowseVault" AutomationProperties.Name="Browse local Artifact Vault"/><Button Content="Copy Vault path" Click="CopyVaultPath" AutomationProperties.Name="Copy Artifact Vault path"/></WrapPanel>
    <TextBlock Text="%LOCALAPPDATA%/FOX2/BridgeDesktop/Artifacts" Foreground="{StaticResource Secondary}" Margin="0,0,0,12"/>
    <TextBlock Text="Explicit selection | Up to 100 MiB | SHA-256 verified" Foreground="{StaticResource Secondary}" Margin="0,0,0,16"/>
    <ItemsControl ItemsSource="{Binding Artifacts}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding FileName}"/><TextBlock Text="{Binding State}" Foreground="{StaticResource Success}"/><TextBlock Text="{Binding Sha256}" FontSize="12" Foreground="{StaticResource Secondary}"/><TextBlock Text="{Binding SizeBytes, StringFormat=Bytes: {0}}" FontSize="12"/><TextBlock Text="{Binding SavedAtUtc, StringFormat=Saved: {0}}" FontSize="12"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Settings" AutomationProperties.Name="Settings"><StackPanel Margin="24,0,0,0"><TextBlock Text="Settings" FontSize="28"/><TextBlock Text="Start with Windows Ã‚Â· current user, limited, interactive" Margin="0,24,0,12"/><WrapPanel><Button Content="Enable startup" Command="{Binding EnableStartup}" AutomationProperties.Name="Enable Start with Windows"/><Button Content="Disable startup" Command="{Binding DisableStartup}" AutomationProperties.Name="Disable Start with Windows"/></WrapPanel><CheckBox IsChecked="{Binding StartWithWindows, Mode=OneWay}" IsEnabled="False" Content="Startup enabled (observed)" Foreground="#F4F7FA" Margin="0,0,0,24"/><CheckBox x:Name="MinimizedSetting" Content="Start Desktop minimized to Tray" Foreground="#F4F7FA" Checked="MinimizedChanged" Unchecked="MinimizedChanged" AutomationProperties.Name="Start minimized"/><TextBlock Text="Closing X hides Desktop. Explicit graceful exit waits for Worker shutdown." Foreground="{StaticResource Secondary}" Margin="0,24,0,16"/><Button Content="{Binding ExitLabel}" Command="{Binding Exit}" HorizontalAlignment="Left" AutomationProperties.Name="Exit after current task" AutomationProperties.AutomationId="GracefulExit"/></StackPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
