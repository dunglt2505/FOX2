{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FOX2_LOCAL_AGENT_DISPATCH_SCHEMA_v1.json",
  "title": "FOX2 Local Agent Dispatch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "dispatch_id",
    "dispatch_action",
    "wp_id",
    "target_agent",
    "workspace_id",
    "policy",
    "task",
    "prompt",
    "source",
    "decision_receipt",
    "runtime_contract",
    "created_by",
    "created_at",
    "max_runs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project": {
      "const": "FOX2"
    },
    "dispatch_id": {
      "type": "string",
      "pattern": "^FOX2-DISPATCH-[A-Za-z0-9._-]+$"
    },
    "dispatch_action": {
      "const": "EXECUTE_LOCAL_AGENT"
    },
    "wp_id": {
      "type": "string",
      "minLength": 1
    },
    "target_agent": {
      "enum": [
        "COPILOT",
        "CODEX"
      ]
    },
    "workspace_id": {
      "const": "FOX2_LOCAL"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "git_path",
        "git_commit_sha"
      ],
      "properties": {
        "version": {
          "const": "1.8"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "git_path": {
          "const": "docs/governance/FOX2_POLICY_V1.8.md"
        },
        "git_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "commit_sha",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/agent_handoff/.+/task\\.md$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "git_source_ready"
      ],
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "git_source_ready": {
          "const": "YES"
        }
      }
    },
    "decision_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_check",
        "task_state_check",
        "routing_r0_r7",
        "assignment_check",
        "execution_authorized",
        "code_allowed"
      ],
      "properties": {
        "policy_check": {
          "const": "PASS"
        },
        "task_state_check": {
          "const": "PASS"
        },
        "routing_r0_r7": {
          "const": "PASS"
        },
        "assignment_check": {
          "const": "PASS"
        },
        "execution_authorized": {
          "const": "YES"
        },
        "code_allowed": {
          "enum": [
            "YES",
            "NO"
          ]
        },
        "dev_grant_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "runtime_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "branch",
        "base_sha",
        "allowed_paths",
        "forbidden_paths",
        "stop_conditions"
      ],
      "properties": {
        "repo": {
          "const": "dunglt2505/FOX2"
        },
        "branch": {
          "type": "string",
          "pattern": "^work/"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "created_by": {
      "const": "CHAT"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "max_runs": {
      "const": 1
    },
    "retry_of_dispatch_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
