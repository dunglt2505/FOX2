{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FOX2_LOCAL_AGENT_DISPATCH_SCHEMA_v2.json",
  "title": "FOX2 Local Agent Dispatch v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "dispatch_id",
    "dispatch_action",
    "wp_id",
    "target_agent",
    "workspace_id",
    "policy",
    "task",
    "prompt",
    "source",
    "routing",
    "execution_path",
    "delivery_owner",
    "permissions",
    "decision_receipt",
    "runtime_contract",
    "required_tests",
    "created_by",
    "created_at",
    "max_runs"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "project": {
      "const": "FOX2"
    },
    "dispatch_id": {
      "type": "string",
      "pattern": "^FOX2-DISPATCH-[A-Za-z0-9._-]+$"
    },
    "dispatch_action": {
      "const": "EXECUTE_LOCAL_AGENT"
    },
    "wp_id": {
      "type": "string",
      "minLength": 1
    },
    "target_agent": {
      "enum": [
        "COPILOT",
        "CODEX"
      ]
    },
    "workspace_id": {
      "const": "FOX2_LOCAL"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "git_path",
        "git_commit_sha"
      ],
      "properties": {
        "version": {
          "const": "1.8.6"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "git_path": {
          "const": "docs/governance/FOX2_POLICY_V1.8.6.md"
        },
        "git_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "commit_sha",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/agent_handoff/.+/task\\.md$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "git_commit",
        "git_blob_sha1",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "git_blob_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "git_source_ready"
      ],
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "git_source_ready": {
          "const": "YES"
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_policy",
        "permission_profile"
      ],
      "properties": {
        "model_policy": {
          "enum": [
            "NATIVE_AUTO",
            "PINNED",
            "CURRENT_CONFIG",
            "PINNED_PREFERRED"
          ]
        },
        "auto_tier": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "efficiency",
            "balance",
            "intelligence",
            null
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_effort": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "low",
            "medium",
            "high",
            null
          ]
        },
        "permission_profile": {
          "type": "string",
          "enum": [
            "FULL_ACCESS",
            "BOUNDED_EXPLICIT"
          ]
        }
      }
    },
    "execution_path": {
      "enum": [
        "BRIDGE",
        "MANUAL_LOCAL",
        "VSCODE_ONE_CLICK"
      ]
    },
    "delivery_owner": {
      "enum": [
        "AGENT",
        "BRIDGE"
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_allowed",
        "git_code_push",
        "git_report_write",
        "git_report_push",
        "pr_create",
        "merge_allowed",
        "production_provider",
        "broker_write",
        "live"
      ],
      "properties": {
        "code_allowed": {
          "type": "boolean"
        },
        "git_code_push": {
          "type": "boolean"
        },
        "git_report_write": {
          "type": "boolean"
        },
        "git_report_push": {
          "type": "boolean"
        },
        "pr_create": {
          "const": false
        },
        "merge_allowed": {
          "const": false
        },
        "production_provider": {
          "const": false
        },
        "broker_write": {
          "const": false
        },
        "live": {
          "const": false
        }
      }
    },
    "decision_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_check",
        "task_state_check",
        "source_binding_check",
        "routing_r0_r7",
        "assignment_check",
        "material_capability_check",
        "execution_authorized",
        "code_allowed"
      ],
      "properties": {
        "policy_check": {
          "const": "PASS"
        },
        "task_state_check": {
          "const": "PASS"
        },
        "source_binding_check": {
          "const": "PASS"
        },
        "routing_r0_r7": {
          "const": "PASS"
        },
        "assignment_check": {
          "const": "PASS"
        },
        "material_capability_check": {
          "enum": [
            "PASS",
            "PASS_NON_MATERIAL_DEVIATION"
          ]
        },
        "execution_authorized": {
          "const": "YES"
        },
        "code_allowed": {
          "enum": [
            "YES",
            "NO"
          ]
        },
        "dev_grant_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "runtime_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "branch",
        "worktree",
        "base_sha",
        "allowed_code_paths",
        "allowed_report_paths",
        "required_capabilities",
        "stop_conditions"
      ],
      "properties": {
        "repo": {
          "const": "dunglt2505/FOX2"
        },
        "branch": {
          "type": "string",
          "pattern": "^work/"
        },
        "worktree": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "allowed_code_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_report_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_by": {
      "const": "CHAT"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "max_runs": {
      "const": 1
    },
    "retry_of_dispatch_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "delivery_owner": {
            "const": "AGENT"
          }
        }
      },
      "then": {
        "properties": {
          "permissions": {
            "properties": {
              "git_code_push": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "routing": {
            "properties": {
              "permission_profile": {
                "const": "FULL_ACCESS"
              }
            }
          }
        }
      },
      "then": {}
    }
  ]
}
